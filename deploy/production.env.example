NODE_ENV=production
HOST=127.0.0.1
PORT=3001
APP_ORIGINS=https://celiawang.fun
STATIC_DIR=../dist
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=friend_dev
MYSQL_DATABASE=friend_product_workbench
MYSQL_PASSWORD_FILE=/etc/product-workbench/mysql_password.txt
BOOTSTRAP_USERNAME=celia
BOOTSTRAP_NAME=celia.wang
BOOTSTRAP_PASSWORD_FILE=/var/lib/product-workbench/bootstrap-admin.txt
AI_CONFIG_FILE=/var/lib/product-workbench/ai-config.json
# 管理员可在 AI 助手的“模型设置”中保存 Key；以下环境变量可选，启用后界面配置只读。
# 可选服务商：deepseek、qwen、openai、kimi；选择 kimi 时默认使用 kimi-k2.6 和 https://api.moonshot.cn/v1。
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-flash
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=填入服务商生成的 Key，勿提交真实值
